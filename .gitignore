# Staged output of scripts/build.py: the whole of what Wrangler uploads as the
# Worker's static assets, including the three PDFs. Rebuilt on every deploy and
# never committed: a committed CV PDF is a CV that can silently disagree with
# data/, which is the one failure this repo is built to make impossible.
dist/

# Wrangler's local state and cache directory.
.wrangler/

# Local Python environment for scripts/build.py and Playwright.
.venv/
__pycache__/
*.pyc

node_modules/
.idea/
.DS_Store
.claude/settings.local.json
