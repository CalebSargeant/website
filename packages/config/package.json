{
  "name": "@app/config",
  "version": "0.1.0",
  "private": true,
  "description": "Thin LOCAL preset. Re-exports @platform/config (tsconfig, prettier, vitest). ESLint + Tailwind presets are LOCAL additions because upstream @platform/config does not provide them.",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./prettier": "./prettier.config.js",
    "./vitest": "./vitest.config.ts",
    "./eslint": "./eslint.config.js",
    "./tailwind": "./tailwind.preset.js"
  },
  "dependencies": {
    "@platform/config": "0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.18.2",
    "eslint": "9.17.0",
    "tailwindcss": "3.4.17",
    "vitest": "2.1.8"
  }
}
