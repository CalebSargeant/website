# =============================================================================
# Golden Stack Consumer (calebsargeant.com) — environment configuration
# Copy to `.env` for local dev. API base URL(s) + auth are ALWAYS config, never
# hardcoded. Defaults below point at local dev.
# =============================================================================

# ---- Backend (apps/api) — pydantic-settings reads these (prefix APP_) ----
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/website
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Résumé single source of truth (defaults to ./content/profile.json).
# APP_PROFILE_PATH=content/profile.json

# "Ask my CV" assistant (Claude API). Without a key the /ask endpoint returns 503.
APP_ANTHROPIC_API_KEY=
APP_ANTHROPIC_MODEL=claude-sonnet-4-6

# Live GitHub stats widget. Token is optional (raises the rate limit).
APP_GITHUB_USERNAME=CalebSargeant
APP_GITHUB_TOKEN=

# Upstream Golden Stack platform API (MagmaMoose/platform) — backend reaches it
# server-to-server (httpx). Single-backend mode (default): only the backend uses these.
APP_PLATFORM_API_BASE_URL=https://api.platform.example.com
APP_PLATFORM_API_TOKEN=replace-me

# ---- Web (apps/web) — Vite exposes only VITE_* to the client ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Mobile (apps/mobile) — Expo exposes only EXPO_PUBLIC_* to the client ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Direct upstream mode ONLY (frontends also hit the platform API) ----
# Leave unset in single-backend mode (the default). If you deliberately chose
# direct mode, set these and wire @platform/api-client in the frontends.
# VITE_PLATFORM_API_BASE_URL=https://api.platform.example.com
# EXPO_PUBLIC_PLATFORM_API_BASE_URL=https://api.platform.example.com
