# Response headers for calebsargeant.com.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Limits: 100 rules, 2,000 characters per line. Rules are ADDITIVE: a request
# matching several rules gets the union of their headers. That is why no two
# rules below ever set the same header name on overlapping paths: two matching
# Cache-Control rules would both contribute, and which one a browser honours is
# not something worth finding out in production.
#
# scripts/build.py copies this file into dist/ and then appends one generated
# rule per markdown twin (see the end of this file). It applies to static asset
# responses only.

/*
  # Two years, subdomains included. `preload` is deliberately left off: the
  # preload list is effectively a one-way door and it would pin every
  # calebsargeant.com subdomain (docs. and anything else added later) to
  # HTTPS-only in shipped browsers. Add it once you are sure they all will
  # always serve valid HTTPS.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Redundant with CSP frame-ancestors below, kept for pre-CSP3 browsers.
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # interest-cohort is the FLoC opt-out. It is a dead API in shipped browsers but
  # costs nothing to keep, and privacy scanners still look for it.
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  # script-src is 'self' plus 'unsafe-inline', and that is a deliberate, honest
  # compromise rather than an oversight.
  #
  # templates/base.html carries exactly one inline script: the theme bootstrap
  # that reads the stored/system preference and stamps data-theme on <html>
  # BEFORE first paint. It has to be inline: moving it into site.js means a
  # frame of the wrong theme on every page load: so the choice is a hash or
  # 'unsafe-inline'.
  #
  # TODO: replace 'unsafe-inline' with the sha256 of that snippet. A hash keeps
  # the policy meaningful (any OTHER inline script stays blocked), which
  # 'unsafe-inline' does not. It is not done yet because the hash has to be
  # recomputed by hand every time the snippet changes by a single character, and
  # a silently-broken theme bootstrap is worse than a slightly loose script-src
  # on a site that accepts no user input. When you do it:
  #     printf "%s" "<exact script body, no surrounding tags>" | openssl dgst -sha256 -binary | openssl base64
  # then swap 'unsafe-inline' for 'sha256-<output>'. Note that browsers IGNORE
  # 'unsafe-inline' once a hash is present, so both can sit here during the
  # changeover only if you accept the hash winning.
  #
  # style-src needs 'unsafe-inline' for the style="" attributes the templates
  # use to pass per-element values into CSS (reveal stagger --d, skill meter
  # widths). Drop it if those ever move into site.css.
  #
  # Two third parties, and only these. Google Fonts: the stylesheet comes from
  # fonts.googleapis.com and the font files it references from
  # fonts.gstatic.com. Cloudflare Web Analytics: the zone has automatic
  # injection on, so Cloudflare adds a
  #     <script src="https://static.cloudflareinsights.com/beacon.min.js/v...">
  # to every HTML response at the edge, and without its host in script-src the
  # beacon is blocked and nothing is collected, which is how it ran until this
  # was added. The HOST, not the /beacon.min.js path Cloudflare's FAQ shows:
  # the injected URL has a version suffix after beacon.min.js, and a source
  # naming an exact file does not match it. The beacon reports to this
  # origin's /cdn-cgi/rum, which default-src 'self' already covers. Nothing
  # else: no CDN, no embeds.
  #
  # There is deliberately no connect-src directive, so same-origin fetches
  # inherit default-src 'self'; if you ever add one, 'self' must be restated in
  # it or every same-origin fetch (the beacon's /cdn-cgi/rum included) breaks
  # in a way that looks exactly like the endpoint being down.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# NOTE ON HTML: there is deliberately no Cache-Control rule for pages here.
# Adding one would have to live on /* , which also matches /assets/* and every
# /downloads/ rule below, and would collide with them. Left alone, the Workers
# asset server serves HTML with an ETag and max-age=0, must-revalidate: a cheap
# 304 on every visit and never a stale page. That is exactly the policy pages
# rebuilt on every deploy want, so it stays the default rather than being
# restated.

# assets/ is copied byte-for-byte by scripts/build.py: site.css, site.js and
# hero-net.js ship at stable, unversioned paths with no content hash. Immutable
# caching on a stable path is a bug, not an optimisation: a CSS fix would not
# reach a returning visitor for a year. An hour of browser caching with a day of
# stale-while-revalidate keeps repeat views instant while capping how long a
# stale theme can linger.
#
# The day templates/base.html starts fingerprinting asset URLs (/assets/site.<hash>.css),
# this becomes `public, max-age=31536000, immutable` and should.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# All six PDFs (three documents x two locales) are REGENERATED ON EVERY DEPLOY
# from data/, which is what stops the published CV drifting from the site.
# Caching them for a year would undo that: a recruiter would be handed the CV as
# it stood the last time their browser happened to fetch it. Five minutes, with
# an hour of stale-while-revalidate so a click is never blocked on a
# revalidation.
#
# A path rule matches from the start of the path, so /downloads/* does NOT cover
# the Dutch copies at /nl/downloads/. Every locale needs its own line here, and
# a locale added to LOCALES in scripts/build.py needs one adding. Without it the
# Dutch PDFs quietly fall back to the default HTML policy, and the fault looks
# like a stale CV rather than a missing header.
/downloads/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/nl/downloads/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# The print sheets exist as the source the PDF renderer prints from, and as a
# "view in browser" convenience. They are the same content as /cv/ with none of
# the design, so indexing them is duplicate content. robots.txt disallows them
# too; this header is the belt to that braces, for crawlers that fetch the URL
# anyway (a Disallowed URL is never fetched, so a well-behaved crawler never
# sees this: the two controls cover different crawlers, not the same one).
#
# Same prefix-matching point as above: /nl/print/ needs its own rule, and it
# matters more here, because the failure is silent and public. An unlisted
# locale's print sheets would be indexable duplicates of its own pages.
/print/*
  X-Robots-Tag: noindex, nofollow

/nl/print/*
  X-Robots-Tag: noindex, nofollow

# CONTENT-LANGUAGE: only the prefixed locales can get one from this file.
#
# /nl/* is every Dutch URL and nothing else, so it can be labelled here. English
# cannot: it lives at the root with no prefix of its own, so the only pattern
# that covers it is /*, and rules are additive. A /* rule setting en-GB would
# also apply to /nl/*, and those responses would go out as two values meaning
# "this document is in both languages", which is worse than saying nothing.
# Enumerating the English pages instead (/cv/*, /experience/* ...) would just
# duplicate the PAGES list in scripts/build.py somewhere it cannot be kept in
# sync. So English carries its language in <html lang> and in the hreflang set
# only, which is what search engines read anyway; this header is a small extra
# for the Dutch pages, not the mechanism.
/nl/*
  Content-Language: nl-NL

# CHARSET ON TEXT. The asset server sends text/plain and text/markdown with no
# charset parameter, and a client that then assumes Latin-1 turns every "·"
# and "ë" in llms.txt or a Dutch twin into mojibake. scripts/build.py writes
# everything as UTF-8, so say so. A rule in this file replaces the header the
# asset server would have sent rather than adding a second one.
#
# /*.txt covers llms.txt, llms-full.txt, robots.txt and security.txt. RFC 9116
# asks for exactly this Content-Type on the last one, so it gains from the rule
# rather than merely tolerating it.
/*.md
  Content-Type: text/markdown; charset=utf-8

/*.txt
  Content-Type: text/plain; charset=utf-8

# AGENT DISCOVERY. Two catalogs that point at https://mcp.calebsargeant.com/, for
# clients that look for tools per domain rather than being told the URL. Both are
# public, read-only metadata, so any origin may read them.
#
# /.well-known/api-catalog is RFC 9727: a Linkset, whose media type carries the
# RFC's profile, and a Link naming itself as the api-catalog, which the RFC wants on
# a HEAD. It has no file extension, so without this rule it would go out as
# application/octet-stream.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Access-Control-Allow-Origin: *

# The AI Catalog (github.com/Agent-Card/ai-catalog), which the MCP Server Card
# extension uses for domain-level discovery. Its media type is its own.
/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json
  Access-Control-Allow-Origin: *

# AGENT SKILLS. build.py (write_agent_skills) writes /.well-known/agent-skills/:
# one SKILL.md per skill, rendered from data/ like llms.txt, and an index.json in
# the Agent Skills Discovery format (github.com/cloudflare/agent-skills-discovery-rfc,
# v0.2.0) carrying each file's SHA-256. Public instructions for agents, so any
# origin may read them, an agent in a browser tab included.
#
# SKILL.md already gets text/markdown; charset=utf-8 from the /*.md rule above,
# which is why the rule below sets no Content-Type and must not: two matching
# rules setting one header send both values joined. index.json is pinned to the
# application/json the RFC requires rather than left to inference.
#
# No Cache-Control on purpose. The asset server's default (revalidate every time,
# with an ETag) means a client can never hold an index.json from one deploy and a
# SKILL.md from another, whose digests would not match.
/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Content-Type: application/json

# CANONICAL LINKS FOR THE MARKDOWN TWINS are not written here. build.py appends
# them to dist/_headers (write_headers), one per page per locale, each a
#     Link: <https://calebsargeant.com/experience/>; rel="canonical"
# on its twin, so search engines index the page and not its plain copy, plus the
# reverse on each page (an alternate Link to its twin, and Vary: Accept). They
# are generated because the set is PAGES x LOCALES; a list kept by hand here
# would fall behind the first time a page was added. The build prints the total
# rule count and fails if it passes Cloudflare's 100.
